# 本地开发配置模板。复制为 .env.dev 后再填写；该模板不包含真实凭据。
RELAY_ENV=dev
RELAY_LISTEN_ADDR=:5006
RELAY_SERVICE_PORT=5006
RELAY_ROUTE_PREFIX=/agents-team
RELAY_LOG_LEVEL=INFO
RELAY_TOKEN_KEY=
RELAY_GOOGLE_TIMEOUT_SECONDS=8
RELAY_STATE_LIMIT_BYTES=1500000
RELAY_MYSQL_HOST=127.0.0.1
RELAY_MYSQL_PORT=3306
RELAY_MYSQL_USER=root
RELAY_MYSQL_PASSWORD=
RELAY_MYSQL_DB=agents_team_relay
RELAY_REDIS_ADDR=127.0.0.1:6379
RELAY_REDIS_USERNAME=
RELAY_REDIS_PASSWORD=
RELAY_REDIS_DB=0
RELAY_REDIS_KEY_PREFIX=agents-team:dev
