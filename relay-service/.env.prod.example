# 自建生产环境配置模板。复制为被 Git 忽略的 .env.prod 后填写，使用独立凭据。
RELAY_ENV=prod
RELAY_LISTEN_ADDR=:8000
RELAY_SERVICE_PORT=5006
RELAY_ROUTE_PREFIX=/agents-team
RELAY_PUBLIC_URL=<https://your-relay.example/agents-team>
RELAY_LOG_LEVEL=INFO
RELAY_TOKEN_KEY=<64位十六进制随机值>
RELAY_GOOGLE_TIMEOUT_SECONDS=8
RELAY_STATE_LIMIT_BYTES=1500000
RELAY_MYSQL_HOST=<生产MySQL主机>
RELAY_MYSQL_PORT=3306
RELAY_MYSQL_USER=<生产MySQL用户>
RELAY_MYSQL_PASSWORD=<生产MySQL密码>
RELAY_MYSQL_DB=agents_team_relay
RELAY_REDIS_ADDR=<生产Redis主机:端口>
RELAY_REDIS_USERNAME=
RELAY_REDIS_PASSWORD=<生产Redis密码>
RELAY_REDIS_DB=0
RELAY_REDIS_KEY_PREFIX=agents-team:prod
